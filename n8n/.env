############
# n8n Dokploy Stack Configuration (PostgreSQL + Task Runners + Sandbox + SearXNG)
# Replace all placeholder values before deploying.
############

# n8n & n8n-runners image tag (must match; check https://github.com/n8n-io/n8n/releases)
N8N_VERSION=2.49.6

# Sandbox service version — API, runner-dind, and sandbox images share one release
# Check stable "service" releases at https://github.com/n8n-io/n8n-sandbox-service/releases (tag without "service/v" prefix)
N8N_SANDBOX_VERSION=1.16.0

# Public domain configured in Dokploy's Domains tab (e.g. https://n8n.example.com)
DOMAIN_NAME=example.com
SUBDOMAIN=n8n

# Number of reverse proxy hops in front of n8n (1 for Dokploy's Traefik; increase if behind Cloudflare/LB)
N8N_PROXY_HOPS=1

# Timezone used by Cron and scheduling nodes
GENERIC_TIMEZONE=Asia/Kolkata

# Encryption key for n8n credentials (generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=change-me-32-byte-hex-encryption-key

# Shared secret for external task runner authentication (generate with: openssl rand -hex 32)
N8N_RUNNERS_AUTH_TOKEN=change-me-32-byte-hex-runners-token

# Sandbox service secrets (generate each with: openssl rand -hex 32)
# N8N_SANDBOX_SERVICE_API_KEY must match SANDBOX_API_KEYS
SANDBOX_API_KEYS=change-me-sandbox-api-key
N8N_SANDBOX_SERVICE_API_KEY=change-me-sandbox-api-key

# Registration token shared between sandbox-api and sandbox-runner-1 (must match)
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=change-me-sandbox-registration-token
SANDBOX_RUNNER_REGISTRATION_TOKEN=change-me-sandbox-registration-token

# Runner API key shared between sandbox-api and sandbox-runner-1 (must match)
SANDBOX_API_RUNNER_API_KEY=change-me-sandbox-runner-key
SANDBOX_RUNNER_API_KEYS=change-me-sandbox-runner-key

# Web search: SearXNG secret & internal URL (generate secret with: openssl rand -hex 32)
SEARXNG_SECRET=change-me-searxng-secret
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080

# Optional: configure n8n Assistant LLM provider key here or in the n8n UI (Settings > Assistant)
# N8N_INSTANCE_AI_MODEL_API_KEY=sk-ant-xxx

# PostgreSQL Credentials (internal-only DB dedicated to n8n)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-n8n-db-password
POSTGRES_DB=n8n

# Execution data pruning (retention in hours: 336 = 14 days, max retained executions)
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# Compression node limits setup
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=2147483648
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=5000

# Task runner timeout default is reduced to 60 seconds (changed to 300 seconds)
N8N_RUNNERS_TASK_TIMEOUT=300

# Unverified community packages are disabled by default
# Installed community packages that are not verified by n8n will stop loading unless the variable is explicitly set to true.
N8N_UNVERIFIED_PACKAGES_ENABLED=flase
