############
# n8n Production Stack Configuration
# Replace all placeholder values before deploying to production.
############

# n8n & n8n-runners image tag (must match; check https://docs.n8n.io/release-notes/)
N8N_VERSION=2.49.6

# DOMAIN_NAME and SUBDOMAIN together determine where n8n will be reachable from
# Example below serves n8n at: https://n8n.example.com
DOMAIN_NAME=example.com
SUBDOMAIN=n8n

# Email address used by Traefik for Let's Encrypt TLS/SSL certificate creation
SSL_EMAIL=user@example.com

# Number of reverse proxy hops in front of n8n (1 for Traefik alone; increase if behind Cloudflare/LB + Traefik)
N8N_PROXY_HOPS=1

# Traefik log level (DEBUG, INFO, WARN, ERROR)
TRAEFIK_LOG_LEVEL=WARN

# Timezone used by Cron and scheduling nodes
GENERIC_TIMEZONE=Asia/Kolkata

# Encryption key for n8n credentials (generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=change-me-32-byte-hex-encryption-key

# Shared secret for external task runner authentication (generate with: openssl rand -hex 32)
N8N_RUNNERS_AUTH_TOKEN=change-me-32-byte-hex-runners-token

# PostgreSQL Admin Credentials (used only for DB initialization & healthchecks)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-admin-password
POSTGRES_DB=n8n

# PostgreSQL Non-Root User (used by n8n at runtime)
POSTGRES_NON_ROOT_USER=n8n_user
POSTGRES_NON_ROOT_PASSWORD=change-me-n8n-db-password

# Execution data pruning (retention in hours: 336 = 14 days, max retained executions)
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
