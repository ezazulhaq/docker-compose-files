############
# Grafana & Observability Stack Configuration
# Replace placeholder values before deploying to production.
############

TZ=Asia/Kolkata

# Grafana Admin Credentials & URL
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-secure-password
GRAFANA_ROOT_URL=https://grafana.yourdomain.com

# Prometheus Retention
PROMETHEUS_RETENTION=15d

# Loki Log Retention (hours, e.g. 168h = 7 days)
LOKI_RETENTION=168h

# Host Docker data-root path for cAdvisor (default: /var/lib/docker)
DOCKER_DATA=/mnt/data/docker
